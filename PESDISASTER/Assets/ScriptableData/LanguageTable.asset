  m_Script: {fileID: 11500000, guid: 0906974b80a8d594ab2c49213611a634, type: 3}
  m_Name: LanguageTable
  m_EditorClassIdentifier: Assembly-CSharp::PESDISASTER.LanguageTable
  TextList:
  - KeyCode: SelectLanguage
    English: Please select a language.
    Japanese: "\u8A00\u8A9E\u3092\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    Chinese: "\u8BF7\u9009\u62E9\u8BED\u8A00\u3002"
  - KeyCode: CameraMovement
    English: Use the mouse wheel to look around.
    Japanese: "\u30DE\u30A6\u30B9\u30DB\u30A4\u30FC\u30EB\u3067\u5468\u308A\u3092\u898B\u6E21\u3059\u3002"
    Chinese: "\u7528\u9F20\u6807\u6EDA\u8F6E\u73AF\u987E\u56DB\u5468\u3002"
  - KeyCode: PlayerMovement
    English: Use WASD to move.
    Japanese: "WASD\u3067\u79FB\u52D5\u3059\u308B\u3002"
    Chinese: "\u4F7F\u7528WASD\u952E\u79FB\u52A8\u3002"
  - KeyCode: EscapeHouse
    English: Escape from the house.
    Japanese: "\u6C11\u5BB6\u304B\u3089\u8131\u51FA\u3059\u308B\u3002"
    Chinese: "\u4ECE\u6C11\u5B85\u4E2D\u9003\u8131\u3002"
  - KeyCode: ExitGame
    English: Exit the game.
    Japanese: "\u30B2\u30FC\u30E0\u3092\u7D42\u4E86\u3059\u308B\u3002"
    Chinese: "\u9000\u51FA\u6E38\u620F\u3002"
  - KeyCode: LookNote
    English: Let's check the note on the bed.
    Japanese: "\u30D9\u30C3\u30C9\u306B\u3042\u308B\u30E1\u30E2\u3092\u8ABF\u3079\u3088\u3046\u3002"
    Chinese: "\u68C0\u67E5\u4E00\u4E0B\u5E8A\u4E0A\u7684\u4FBF\u6761\u3002"
  - KeyCode: EscapeNavi
    English: "Good morning.  It\u2019s a disaster, but our daily lives have been
      shattered by a mysterious bacterium.  I don\u2019t have time to go into details. 
      Escape from this house and come to \u201Cthe Factory.\u201D  I\u2019ll explain
      everything there."
    Japanese: "\u304A\u306F\u3088\u3046  \u707D\u96E3\u3060\u304C\u3001\u79C1\u305F\u3061\u306E\u65E5\u5E38\u306F\u8B0E\u306E\u7D30\u83CC\u3067\u58CA\u3055\u308C\u3066\u3057\u307E\u3063\u305F\u3002 
      \u7D30\u304B\u3044\u3053\u3068\u3092\u6559\u3048\u308B\u6642\u9593\u306F\u306A\u3044\u3002 
      \u3053\u306E\u5BB6\u304B\u3089\u8131\u51FA\u3057\u3066\u3001\u300E\u5DE5\u5834\u300F\u306B\u6765\u3066\u304F\u308C\u3002 
      \u305D\u3053\u3067\u3059\u3079\u3066\u3092\u8A71\u305D\u3046\u3002"
    Chinese: "\u65E9\u4E0A\u597D\u3002\u867D\u7136\u5F88\u4E0D\u5E78\uFF0C\u4F46\u6211\u4EEC\u7684\u65E5\u5E38\u751F\u6D3B\u5DF2\u88AB\u4E00\u79CD\u795E\u79D8\u7684\u7EC6\u83CC\u5F7B\u5E95\u6253\u4E71\u4E86\u3002\u6CA1\u65F6\u95F4\u8DDF\u4F60\u7EC6\u8BF4\u4E86\u3002\u5FEB\u4ECE\u8FD9\u680B\u623F\u5B50\u91CC\u9003\u51FA\u6765\uFF0C\u5230\u201C\u5DE5\u5382\u201D\u6765\u3002\u5230\u90A3\u91CC\u6211\u518D\u628A\u4E00\u5207\u90FD\u544A\u8BC9\u4F60\u3002"
